---
import BaseLayout from '../../layouts/BaseLayout.astro';
import seoMatrix from '../../data/seo_matrix.json';
import { PROFILE, getWhatsAppLink } from '../../data/profile';

export function getStaticPaths() {
  return seoMatrix.pages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const cityLower = page.city.toLowerCase();
const isHomeCareCity = cityLower.includes('guarujá') || cityLower.includes('santos');

const relatedPages = seoMatrix.pages
  .filter((p) => p.slug !== page.slug && (p.city === page.city || p.specialty === page.specialty))
  .slice(0, 6);

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Como funciona a psicoterapia online para ${page.specialty}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `As sessões de psicoterapia online têm duração de 50 minutos, ocorrem nos períodos da manhã ou tarde por videochamada sigilosa e são conduzidas por ${PROFILE.name} (${PROFILE.crp}), psicóloga graduada pelo UNISAL com 10 anos de experiência clínica e abordagem na Psicanálise Winnicottiana.`
      }
    },
    {
      "@type": "Question",
      "name": `Vocês emitem recibo para reembolso de convênio médico?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim. O atendimento é particular com emissão de recibo válido para solicitação de reembolso junto aos planos de saúde que oferecem essa cobertura."
      }
    }
  ]
};

const customWppMsg = `Olá, Daniele! Vi a página sobre ${page.specialty} (${page.city}) e gostaria de saber sobre horários disponíveis.`;
---

<BaseLayout
  title={`${page.title} | ${PROFILE.name}`}
  description={`${page.description} Psicoterapia online e psicólogo online com abordagem na Psicanálise Winnicottiana para adolescentes (15+), adultos e idosos (${PROFILE.crp}).`}
  canonicalPath={`/atendimento/${page.slug}`}
  schema={faqSchema}
>
  <nav style="font-size: 0.85rem; margin-bottom: 1rem; color: var(--muted);">
    <a href="/" style="color: var(--primary); text-decoration: none;">Início</a> &rsaquo;
    <span>Psicoterapia Online</span> &rsaquo;
    <span>{page.specialty}</span> &rsaquo;
    <span>{page.city}</span>
  </nav>

  <span class="badge">{PROFILE.shortApproach} • {PROFILE.crp} • {page.city}</span>
  <h1>{page.h1}</h1>
  <p style="font-size: 1.12rem; color: var(--text);">
    {page.description} Sessões de <strong>psicoterapia online</strong> conduzidas por <strong>{PROFILE.name}</strong> ({PROFILE.crp}), psicóloga com 10 anos de prática clínica, orientada pela <strong>Psicanálise Winnicottiana</strong> para <strong>adolescentes a partir de 15 anos, adultos e idosos</strong>.
  </p>

  {isHomeCareCity && (
    <div class="card" style="border-left: 4px solid var(--primary); background: #f4f8f6;">
      <h3>Atendimento Psicológico Domiciliar em Guarujá e Santos</h3>
      <p style="margin-bottom: 0; color: var(--text);">
        Além do formato de <strong>psicólogo online</strong> por videochamada, para pacientes residentes em <strong>Guarujá e Santos</strong> há a possibilidade de atendimento domiciliar voltado a <strong>idosos, pessoas com mobilidade reduzida ou pacientes em quadros depressivos</strong> nos quais sair de casa seja dificultoso devido ao momento clínico.
      </p>
    </div>
  )}

  <div class="card" style="background: var(--accent); border-color: #cbd8cf;">
    <h2>Agende sua sessão (Manhã ou Tarde)</h2>
    <p style="color: var(--text);">
      Atendimento individual sigiloso (e-Psi ativo), com horários nos períodos da <strong>manhã e da tarde</strong> e emissão de <strong>recibo para reembolso de convênio</strong>.
    </p>
    <a href={getWhatsAppLink(customWppMsg)} target="_blank" rel="noopener noreferrer" class="btn">
      Falar com Daniele no WhatsApp
    </a>
  </div>

  <h2>Diferenciais do Atendimento Clínico</h2>
  <div class="grid">
    <div class="card">
      <h3>Psicanálise Winnicottiana</h3>
      <p>Baseada na clínica de Donald Woods Winnicott, prioriza um ambiente de acolhimento seguro (<em>holding</em>), respeitando o tempo e a história singular de cada pessoa.</p>
    </div>
    <div class="card">
      <h3>Formação e Experiência (Desde 2016)</h3>
      <p>Graduada pelo <strong>UNISAL (Lorena-SP)</strong> com início prático na <strong>USP-Lorena</strong>. Ampla experiência presencial (desde 2016) e online (desde 2021).</p>
    </div>
    <div class="card">
      <h3>Público e Reembolso</h3>
      <p>Atendimento para <strong>adolescentes (15+), adultos e idosos</strong>, com emissão de recibo para reembolso em planos de saúde.</p>
    </div>
  </div>

  <h2>Perguntas Frequentes sobre Psicólogo Online</h2>
  <div class="card">
    <h3>Como funciona a psicoterapia online na abordagem Winnicottiana?</h3>
    <p>As sessões duram 50 minutos por videochamada criptografada. O foco é construir um espaço confiável de escuta e elaboração emocional, regulamentado pelo Conselho Federal de Psicologia ({PROFILE.crp}).</p>
  </div>
  <div class="card">
    <h3>Qual a história e vínculo regional da psicóloga?</h3>
    <p><strong>{PROFILE.name}</strong> (37 anos, casada e mãe) é natural de <strong>Piquete-SP</strong>, formou-se pelo <strong>UNISAL</strong> e iniciou na <strong>USP-Lorena</strong>, tendo atuado anos em consultório em <strong>Lorena-SP</strong>. Hoje reside no <strong>Guarujá-SP</strong>, atendendo online em todo o Brasil e em domicílio em Guarujá e Santos.</p>
  </div>

  {relatedPages.length > 0 && (
    <section>
      <h2>Outras especialidades e localidades em psicoterapia online</h2>
      <div class="grid">
        {relatedPages.map((rel) => (
          <a href={`/atendimento/${rel.slug}`} class="link-card">
            <strong>{rel.h1}</strong>
            <span>{rel.city} &bull; Psicoterapia Online &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
