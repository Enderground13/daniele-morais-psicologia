---
import BaseLayout from '../layouts/BaseLayout.astro';
import seoMatrix from '../data/seo_matrix.json';
import { PROFILE, getWhatsAppLink } from '../data/profile';

const specialtyPages = seoMatrix.pages.filter((p) => p.type === 'especialidade');
const cityPages = seoMatrix.pages.filter((p) => p.type === 'cidade');
---

<BaseLayout
  title={`${PROFILE.name} | Psicoterapia Online e Psicólogo Online (${PROFILE.crp})`}
  description="Psicoterapia online ética e acolhedora para adolescentes (15+), adultos e idosos. Atendimento por videochamada com sigilo absoluto, recibo para reembolso e opção domiciliar em Guarujá e Santos."
  canonicalPath="/"
>
  <!-- PRIMEIRA DOBRA: Gancho Imediato (Regra dos 3 Segundos) -->
  <section class="hero">
    <span class="badge">Atendimento Online Regulamentado • {PROFILE.crp}</span>
    <h1>Psicoterapia Online: um espaço seguro para cuidar de você, onde estiver.</h1>
    <p class="hero-sub">
      Escuta profissional, acolhedora e sigilosa por videochamada para ajudar você a atravessar ansiedade, esgotamento, tristeza ou momentos difíceis sem precisar enfrentar trânsito.
    </p>
    <div>
      <a href={getWhatsAppLink()} target="_blank" rel="noopener noreferrer" class="btn">
        Agendar Primeira Conversa pelo WhatsApp &rarr;
      </a>
    </div>
    <div class="trust-strip">
      <span>&#10003; 10 anos de experiência clínica</span>
      <span>&#10003; Adolescentes (15+), Adultos e Idosos</span>
      <span>&#10003; Manhã e Tarde • Recibo p/ Reembolso</span>
    </div>
  </section>

  <!-- SEGUNDA DOBRA: Conexão Humana, Foto e Abordagem Psicanalítica -->
  <div class="card" style="overflow: hidden;">
    <h2>Sobre Daniele Barbosa Pirriello de Morais</h2>
    <img
      src="/daniele-morais-psicologa.jpeg"
      alt="Daniele Barbosa Pirriello de Morais - Psicóloga Clínica"
      style="width:170px;height:170px;object-fit:cover;object-position:center top;border-radius:14px;float:left;margin:0 1.35rem 1rem 0;border:2px solid var(--border);"
    />
    <p>
      <strong>{PROFILE.name}</strong> ({PROFILE.crp}) tem 37 anos, é casada, mãe e psicóloga clínica com <strong>10 anos de experiência</strong> (atuação presencial desde 2016 e psicoterapia online consolidada desde 2021).
    </p>
    <p>
      Sua escuta é orientada pela <strong>Psicanálise Winnicottiana</strong> (referência em <em>Donald Woods Winnicott</em>), abordagem reconhecida por oferecer um ambiente de sustento emocional (<em>holding</em>) e respeito ao tempo de cada pessoa.
    </p>
    <p>
      Graduada pelo <strong>UNISAL</strong>, iniciou sua prática na <strong>USP-Lorena</strong> e atua online para todo o Brasil, com residência em <strong>Guarujá-SP</strong>.
    </p>

    <div class="grid" style="clear: both; padding-top: 0.75rem;">
      <div style="background: var(--bg); padding: 1.1rem; border-radius: 10px; border: 1px solid var(--border);">
        <h3 style="font-size: 0.98rem;">Horários e Reembolso</h3>
        <p style="margin-bottom: 0; font-size: 0.9rem;">Sessões nos períodos da <strong>manhã e da tarde</strong>. Atendimento particular com emissão de <strong>recibo para reembolso</strong>.</p>
      </div>
      <div style="background: var(--warm-bg); padding: 1.1rem; border-radius: 10px; border-left: 4px solid var(--cta);">
        <h3 style="font-size: 0.98rem;">Atendimento Domiciliar (Guarujá e Santos)</h3>
        <p style="margin-bottom: 0; font-size: 0.9rem;">Opção presencial em domicílio em <strong>Guarujá e Santos</strong> para idosos ou pessoas com mobilidade reduzida.</p>
      </div>
    </div>
  </div>

  <!-- TERCEIRA DOBRA: Redução de Fricção -->
  <h2>Como funciona o início da sua psicoterapia online</h2>
  <div class="grid">
    <div class="card">
      <h3>1. Mensagem Rápida no WhatsApp</h3>
      <p>Envie um oi sem compromisso para verificar horários livres pela manhã ou à tarde.</p>
    </div>
    <div class="card">
      <h3>2. Primeiro Encontro de Acolhimento</h3>
      <p>Sessão individual de 50 minutos por videochamada criptografada e sigilosa.</p>
    </div>
    <div class="card">
      <h3>3. Continuidade no Seu Tempo</h3>
      <p>Definimos a frequência das sessões e o envio de recibo para convênio.</p>
    </div>
  </div>

  <!-- QUARTA DOBRA: Clusters de SEO Programático -->
  <h2>Como a psicoterapia online pode ajudar você</h2>
  <div class="grid">
    {specialtyPages.map((page) => (
      <a href={`/atendimento/${page.slug}`} class="link-card">
        <strong>{page.specialty}</strong>
        <span>{page.description}</span>
      </a>
    ))}
  </div>

  <h2>Psicólogo Online por Cidade e Região</h2>
  <div class="grid">
    {cityPages.map((page) => (
      <a href={`/atendimento/${page.slug}`} class="link-card">
        <strong>Psicólogo Online em {page.city}</strong>
        <span>Saiba como agendar sua sessão &rarr;</span>
      </a>
    ))}
  </div>
</BaseLayout>
