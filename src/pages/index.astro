---
import BaseLayout from '../layouts/BaseLayout.astro';
import seoMatrix from '../data/seo_matrix.json';
import { PROFILE, getWhatsAppLink } from '../data/profile';

const specialtyPages = seoMatrix.pages.filter((p) => p.type === 'especialidade');
const homeCareCities = seoMatrix.pages.filter(
  (p) => p.type === 'cidade' && (p.city.includes('Guarujá') || p.city.includes('Santos'))
);
---

<BaseLayout
  title={`${PROFILE.name} | Psicoterapia Online e Psicólogo Online (${PROFILE.crp})`}
  description="Psicoterapia online ética e acolhedora para adolescentes (15+), adultos e idosos. Atendimento por videochamada de onde você estiver, com sigilo absoluto, recibo para reembolso e opção domiciliar em Guarujá e Santos."
  canonicalPath="/"
>
  <!-- Estrutura principal otimizada para UX e conversão -->
</BaseLayout>
