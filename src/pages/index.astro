---
import BaseLayout from '../layouts/BaseLayout.astro';
import seoMatrix from '../data/seo_matrix.json';
import { PROFILE, getWhatsAppLink } from '../data/profile';

const specialtyPages = seoMatrix.pages.filter((p) => p.type === 'especialidade');
const cityPages = seoMatrix.pages.filter((p) => p.type === 'cidade');
---

<BaseLayout
  title={`${PROFILE.name} | Psicóloga Online e Psicanálise Winnicottiana (${PROFILE.crp})`}
  description="Psicoterapia online e psicólogo online com orientação na Psicanálise Winnicottiana. Graduada pelo UNISAL, atuação clínica desde 2016..."
  canonicalPath="/"
>
  <!-- Conteúdo da página index.astro com a foto da profissional e seções de atendimento -->
</BaseLayout>
